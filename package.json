{
  "name": "paperwork",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-pdfjs-assets.mjs && node scripts/fetch-fonts.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs && node scripts/fetch-fonts.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node scripts/fetch-fonts.mjs && vitest run",
    "fonts": "node scripts/fetch-fonts.mjs",
    "render-pdf": "tsx scripts/render-pdf.ts",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -b --noEmit",
    "check:seo": "tsx scripts/check-seo.ts",
    "deploy": "cf deploy --prebuilt --mode production"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@embedpdf/pdfium": "2.15.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-thai": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tailwindcss/vite": "^4",
    "bidi-js": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "fflate": "^0.8.3",
    "harfbuzzjs": "^1.6.4",
    "i18next": "^26.5.11",
    "i18next-browser-languagedetector": "^8.2.3",
    "konva": "^10.9.0",
    "lucide-react": "^1.61.0",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-konva": "^19.3.2",
    "react-router": "^8.5.0",
    "shadcn": "^4.22.1",
    "signature_pad": "^5.1.4",
    "sonner": "^2.0.8",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.5",
    "@eslint/js": "^10",
    "@napi-rs/canvas": "^1.0.13",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "cf": "1.0.0-beta.23",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.22.0"
  },
  "packageManager": "pnpm@12.11.2"
}
